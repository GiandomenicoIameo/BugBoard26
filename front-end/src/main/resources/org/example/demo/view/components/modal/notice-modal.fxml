<VBox fx:id="noticeModal" alignment="TOP_CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="573.0" prefWidth="530.0" style="-fx-border-radius: 10px; -fx-background-color: #fafafb;" styleClass="notify-bar" stylesheets="@../../style/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <HBox alignment="CENTER" fillHeight="false" maxHeight="47.0" minHeight="47.0" style="-fx-background-color: #EBEBEB; -fx-background-radius: 10 10 0 0; -fx-border-color: rgba(0,0,0,0.12); -fx-border-width: 0 0 1 0;" VBox.vgrow="NEVER">
         <children>
            <Label text="Notification" textFill="#241f31" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="Cantarell Bold" size="18.0" />
               </font>
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin>
            </Label>
            <Pane prefHeight="46.0" prefWidth="192.0" HBox.hgrow="ALWAYS" />
            <Button alignment="CENTER" graphicTextGap="10.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#close" prefHeight="23.0" prefWidth="23.0" style="-fx-border-radius: 20px; -fx-background-radius: 20px;" styleClass="btn-close" stylesheets="@../../style/style.css">
               <font>
                  <Font name="Cantarell Regular" size="18.0" />
               </font>
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0" styleClass="icon-bell-close" />
               </graphic>
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <ScrollPane fx:id="scroll" fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
         <content>
            <VBox alignment="TOP_CENTER">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label text="New ·" textFill="#5e5c63">
                           <font>
                              <Font name="Cantarell Regular" size="17.0" />
                           </font>
                           <HBox.margin>
                              <Insets right="5.0" />
                           </HBox.margin>
                        </Label>
                        <Label fx:id="numNotice" text="4" textFill="#5e5c63">
                           <font>
                              <Font name="Cantarell Regular" size="17.0" />
                           </font>
