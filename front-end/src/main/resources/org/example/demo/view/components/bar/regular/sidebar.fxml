            <ToggleButton alignment="CENTER_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#viewSettings" prefHeight="47.0" prefWidth="289.0" styleClass="btn-sidebar" stylesheets="@../../../style/style.css" text="Settings" textFill="#49454f" toggleGroup="$gruppo">
