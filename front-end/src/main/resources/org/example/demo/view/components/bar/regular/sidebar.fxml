<VBox fx:id="sidebar" prefHeight="733.0" prefWidth="309.0" style="-fx-background-color: #ebebeb; -fx-background-radius: 10px 0 0 10px; -fx-border-color: rgba(73, 69, 79, 0.20); -fx-border-width: 0 1 0 0;" stylesheets="@../../../style/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <AnchorPane fx:id="menubar" prefHeight="47.0" style="-fx-background-color: #ebebeb; -fx-border-color: rgba(73, 69, 79, 0.20); -fx-border-width: 0 0 1 0px; -fx-background-radius: 10 0 0 0;">
         <children>
            <Label alignment="CENTER" layoutX="106.0" layoutY="12.0" text="Menu" textFill="#49454f" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
               <font>
                  <Font name="Cantarell Bold" size="16.0" />
               </font>
            </Label>
            <Button fx:id="assignIssueModal" layoutX="262.0" layoutY="6.0" mnemonicParsing="false" onAction="#viewNotice" prefHeight="34.0" prefWidth="38.0" style="-fx-border-radius: 10px; -fx-background-radius: 10px;" styleClass="btn-labels">
               <graphic>
                  <Region prefHeight="200.0" prefWidth="200.0" styleClass="icon-bell-assignments" />
