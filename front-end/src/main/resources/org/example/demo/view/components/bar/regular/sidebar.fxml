         </toggleGroup>
         <VBox.margin>
            <Insets bottom="5.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
         <graphic>
            <Region prefHeight="34.0" prefWidth="32.0" styleClass="icon-bell-sidebar-issue" />
         </graphic>
      </ToggleButton>
      <ToggleButton alignment="CENTER_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#viewAssignments" prefHeight="47.0" prefWidth="289.0" styleClass="btn-sidebar" stylesheets="@../../../style/style.css" text="Assigned to me" textFill="#49454f" toggleGroup="$gruppo">
