                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets top="5.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox alignment="CENTER" prefHeight="53.0" prefWidth="323.0">
                     <children>
                              <TextField fx:id="email" prefHeight="63.0" promptText="Username or email address" style="-fx-border-radius: 10px;" styleClass="username-text" HBox.hgrow="ALWAYS">
