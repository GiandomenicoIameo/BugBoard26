            <HBox fx:id="user1" alignment="CENTER" fillHeight="false" layoutX="476.0" layoutY="204.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Sign in to see and manage your issues" textAlignment="CENTER" textFill="#5e5c63" wrapText="true" HBox.hgrow="ALWAYS">
                     <font>
                        <Font name="Cantarell Regular" size="20.0" />
                     </font>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <Label alignment="CENTER" contentDisplay="CENTER" layoutX="539.0" layoutY="151.0" text="BugBoard26" textAlignment="CENTER" textFill="#5e5c63" wrapText="true">
               <font>
                  <Font name="Cantarell Regular" size="36.0" />
               </font>
            </Label>
            <StackPane layoutX="608.0" layoutY="83.0" maxHeight="71.0" maxWidth="66.0" prefHeight="71.0" prefWidth="66.0" styleClass="icon-circle">
               <children>
                  <Region prefHeight="200.0" prefWidth="200.0" styleClass="icon-bell-logo" />
               </children>
