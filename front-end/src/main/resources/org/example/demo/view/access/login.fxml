                              <Font name="Cantarell Regular" size="18.0" />
                           </font>
                              </TextField>
                     </children>
                     <VBox.margin>
                        <Insets bottom="10.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox prefWidth="610.0">
                     <children>
                        <Label text="Password" textFill="#5e5c63">
                           <font>
                              <Font name="Cantarell Regular" size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox prefHeight="53.0" prefWidth="323.0">
                     <children>
                              <PasswordField fx:id="password" prefHeight="63.0" prefWidth="323.0" promptText="Password" style="-fx-border-radius: 10px;" styleClass="password-text" HBox.hgrow="ALWAYS">
                                  <font>
                              <Font name="Cantarell Regular" size="18.0" />
                           </font>
                              </PasswordField>
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </HBox>
                  <HBox prefHeight="53.0" prefWidth="323.0">
                     <children>
                              <Button defaultButton="true" mnemonicParsing="false" onAction="#signIn" prefHeight="63.0" prefWidth="323.0" styleClass="btn-signin" text="Sign in" textFill="WHITE" HBox.hgrow="ALWAYS">
                                  <font>
                              <Font name="Cantarell Regular" size="18.0" />
                           </font>
                              </Button>
                     </children>
                  </HBox>
                    </children>
                </VBox>

                <!-- Barra del titolo -->
                <AnchorPane maxHeight="40.0" minHeight="40.0" prefHeight="40.0" style="-fx-border-color: rgba(73, 69, 79, 0.20); -fx-background-color: #ebebeb; -fx-border-width: 0 0 1 0; -fx-background-radius: 10 10 0 0;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <children>
                        <Button fx:id="btnMin" mnemonicParsing="false" onAction="#minimize" prefHeight="23.0" prefWidth="23.0" style="-fx-border-radius: 20px; -fx-background-radius: 20px;" styleClass="btn-close" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="8.0">
                            <graphic><Region styleClass="icon-bell-minimize" /></graphic>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#close" prefHeight="23.0" prefWidth="23.0" style="-fx-border-radius: 20px; -fx-background-radius: 20px;" styleClass="btn-close" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="8.0">
                            <graphic><Region styleClass="icon-bell-close" /></graphic>
                        </Button>
                    </children>
                </AnchorPane>
            <HBox fx:id="newUserCard" alignment="CENTER" fillHeight="false" layoutX="426.0" layoutY="590.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="73.0" prefWidth="425.0">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" text="Accounts are created by an Administrator. If you cannot  sign in, contact your administrator." textAlignment="CENTER" textFill="#5e5c63" wrapText="true" HBox.hgrow="ALWAYS">
