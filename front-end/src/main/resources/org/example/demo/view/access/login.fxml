<StackPane prefHeight="866.0" prefWidth="1298.0" style="-fx-background-color: transparent;" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <AnchorPane fx:id="login" prefHeight="560.0" prefWidth="460.0" style="-fx-background-color: #fafafb; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-border-color: rgba(73, 69, 79, 0.25);" stylesheets="@../style/style.css" StackPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" layoutX="426.0" layoutY="262.0" prefHeight="328.0" prefWidth="425.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10px;" styleClass="card-login">
                    <padding>
                        <Insets bottom="30.0" left="50.0" right="50.0" top="20.0" />
                    </padding>
                    <children>
                  <HBox>
                     <children>
                        <Label text="Email address" textFill="#5e5c63">
